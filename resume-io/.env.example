# Resume IO 环境变量示例
# 使用方式：复制为 .env 或在终端中 export / set（切勿将真实 Key 提交到 Git）

# ========== 必填：DeepSeek 大模型 ==========
# 申请地址：https://platform.deepseek.com/
DASHSCOPE_API_KEY=sk-your-deepseek-api-key-here

# ========== 可选：JWT（生产环境务必修改，至少 32 字节） ==========
JWT_SECRET=your-random-jwt-secret-at-least-32-bytes

# ========== 可选：MySQL（默认与 docker-compose.yml 一致） ==========
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=resume_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# ========== 可选：Redis ==========
REDIS_HOST=localhost
REDIS_PORT=6379

# ========== 可选：功能开关 ==========
APP_DEMO_DATA=true
SENSITIVE_STORAGE=redis
