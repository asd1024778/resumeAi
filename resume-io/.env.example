# Resume IO 环境变量示例
# 使用方式：复制为 .env 或在终端中 export / set（切勿将真实 Key 提交到 Git）

# ========== 必填：DeepSeek 大模型 ==========
# 申请地址：https://platform.deepseek.com/
# 代码优先读 DEEPSEEK_API_KEY；DASHSCOPE_API_KEY 为历史变量名，仍兼容
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
# 模型：deepseek-flash（默认，快）| deepseek-v4-pro（更强，慢）
DEEPSEEK_MODEL=deepseek-flash

# ========== 可选：JWT（生产环境务必修改，至少 32 字节） ==========
JWT_SECRET=your-random-jwt-secret-at-least-32-bytes

# ========== 可选：MySQL（默认与 docker-compose.yml 一致） ==========
# 注意：Docker 里的 MySQL 映射在宿主机 3307（3306 常被本机 MySQL80 占用）
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_DATABASE=resume_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# ========== 可选：Redis ==========
# 注意：Docker 里的 Redis 映射在宿主机 6380（6379 常被 WSL 里的 Redis 占用）
REDIS_HOST=localhost
REDIS_PORT=6380

# ========== 可选：功能开关 ==========
APP_DEMO_DATA=true
SENSITIVE_STORAGE=redis
# 开发期把短信验证码随响应回传，接入真实网关后改为 false
SMS_DEBUG_RETURN_CODE=true
