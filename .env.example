# ============================================================
# Resume IO 全栈 Docker Compose 环境变量【示例文件】
#
#   copy .env.example .env      # 复制后填入你自己的 Key
#
# ⚠ .env 已被 .gitignore 忽略，真实密钥只放在本地 .env，
#   绝对不要提交 .env、也不要把 Key 写进 README / compose / Dockerfile。
# ============================================================

# ========== 必填：DeepSeek API Key ==========
# 申请：https://platform.deepseek.com/
# 也可用历史变量名 DASHSCOPE_API_KEY（代码仍兼容）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 模型：deepseek-flash（默认，快）| deepseek-v4-pro（更强，慢）
DEEPSEEK_MODEL=deepseek-flash

# ========== 认证 / 功能开关 ==========
# 生产环境务必改成随机值（JWT HS256 要求密钥 >= 32 字节）
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes
APP_DEMO_DATA=true
# 敏感资料存储：redis（默认）| memory
SENSITIVE_STORAGE=redis

# 短信验证码
# 开发期把验证码随响应回传，方便无短信网关时联调；生产改为 false
SMS_DEBUG_RETURN_CODE=true

# ========== 宿主机端口映射（冲突时改这里即可） ==========
# 前端浏览器访问地址：http://localhost:${FRONTEND_PORT}
FRONTEND_PORT=5173
# 后端接口地址：http://localhost:${BACKEND_PORT}
BACKEND_PORT=8080
# 本机 MySQL80 常占用 3306，因此 Docker MySQL 默认映射 3307
MYSQL_HOST_PORT=3307
# WSL / 原生 Redis 常占用 6379，因此 Docker Redis 默认映射 6380
REDIS_HOST_PORT=6380

# ========== 数据库账号（容器内部使用，端口固定为 3306 / 6379） ==========
MYSQL_DATABASE=resume_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# ========== 后端 JVM 参数 ==========
JAVA_OPTS=-Xms256m -Xmx512m

# ========== npm 镜像源（前端镜像构建用，留空=官方源） ==========
# 国内网络慢可改为：https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmmirror.com

# ========== Docker 基础镜像（默认官方；国内可加镜像前缀） ==========
# 例：MAVEN_IMAGE=docker.m.daocloud.io/library/maven:3.9-eclipse-temurin-17
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7-alpine
MAVEN_IMAGE=maven:3.9-eclipse-temurin-17
JRE_IMAGE=eclipse-temurin:17-jre-jammy
NODE_IMAGE=node:20-alpine
NGINX_IMAGE=nginx:1.27-alpine
